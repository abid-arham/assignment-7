# Base URL of the UMS API (assignment 6), including /api/v1. Server-only.
API_BASE_URL=https://assignment-6-tau-wine.vercel.app/api/v1

# Same value as the API's JWT_ACCESS_SECRET. proxy.ts uses it to verify access tokens. Server-only.
JWT_ACCESS_SECRET=

# Public origin of this frontend (metadata, Open Graph URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shown on the contact page.
# NEXT_PUBLIC_CONTACT_EMAIL=registrar@ums.demo

# Optional: override the accounts behind the one-click demo buttons (defaults match the API seed).
# DEMO_ADMIN_EMAIL=admin@ums.demo
# DEMO_ADMIN_PASSWORD=
# DEMO_STUDENT_EMAIL=student1@ums.demo
# DEMO_STUDENT_PASSWORD=
# DEMO_INSTRUCTOR_EMAIL=instructor1@ums.demo
# DEMO_INSTRUCTOR_PASSWORD=
